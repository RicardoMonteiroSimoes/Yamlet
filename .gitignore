# macOS filesystem cruft
.DS_Store

# Compiled single-file binaries (produced by `deno task compile`).
# The source in tooling/ is the truth; the ~70 MB binary is a build artifact.
dist/

# Generated graph views (produced by `yamlet graph --format=html`). Reproducible
# from the specs, so the source specs are the truth, not the emitted HTML.
*_graph.html

# Per-machine Claude Code permissions. A shared .claude/settings.json (if any)
# and the .claude/skills/ conventions are tracked; the local overrides are not.
.claude/settings.local.json

# pi's project-local directory. Everything in it here is machine-local: the
# packages `pi install -l` fetches, and the extension/agent/skill symlinks that
# `./pi/install.sh --project` creates to dogfood the pi port from this repo.
# The source of truth is pi/ — .pi/ is only ever a generated view of it.
.pi/

# The pi-port workflow installs pi's packages at the repo root (--no-save) so the
# extension's bare imports resolve. Nothing here depends on them being present.
node_modules/
